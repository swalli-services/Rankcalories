# Copia a .env.local y reemplaza estos ejemplos con datos públicos del proyecto.
# Los ejemplos mantienen la aplicación en estado de configuración pendiente.
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REEMPLAZAR_CON_TU_CLAVE
# Habilitar solo después de configurar Google en Supabase y Google Cloud.
VITE_GOOGLE_AUTH_ENABLED=false
# Nunca incluir secretos OAuth, sb_secret_* ni service_role en VITE_*.
